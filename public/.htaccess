# bez-poprawek.pl – strona statyczna (Apache na VPS 192.109.241.30, bez PHP)
Options -MultiViews
RewriteEngine On

# jeden skok na adres kanoniczny: https i bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://bez-poprawek.pl%{REQUEST_URI} [R=301,L,NE]

# stare adresy z końcówką .php (strona była w PHP) przekierowuje vhost (/etc/apache2/strony/<domena>/stare-php.conf,
# serwer/strona-wgrywanie.sh --stare-php) – tutaj byłoby za późno: Apache blokuje *.php, zanim przeczyta .htaccess.
# poniższe reguły tylko dla zapytań z przeglądarki, nie dla wewnętrznych (strona błędu 404)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.html$ / [R=301,L]
# ukośnik na końcu -> bez (jeden adres na stronę)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# adresy bez .html
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# nieistniejący adres -> strona główna (z kodem 404), jak na starym serwerze
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # CSS i JS bez wersji w adresie – krótko, żeby zmiany było widać po dniu
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript image/svg+xml
</IfModule>
